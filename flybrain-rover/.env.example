NEUPRINT_TOKEN=
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=male-cns:v1.0

# ElevenLabs: voice lines (scripts/voice.py) and the talk-to-the-fly agent (scripts/talk.py --create-agent)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# optional: the fly's voice, read by both voice.py and talk.py. Default is George (JBFqnCBsd6RMkjVDRZzb)
# at speed 1.0. Set these once a voice is chosen, then run talk.py --update-agent to push them onto the
# existing agent (does not create a new one, does not regenerate the cached narration lines).
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_SPEED=
# Tiger Cloud / TimescaleDB / any Postgres, for scripts/export_timeseries.py
TIMESERIES_DSN=
