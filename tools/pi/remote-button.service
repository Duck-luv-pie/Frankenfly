# The lobotomy remote at boot. Install on the REMOTE Pi:
#   sudo apt install python3-gpiozero && sudo cp remote-button.service /etc/systemd/system/ && sudo systemctl enable --now remote-button
[Unit]
Description=Companion remote: a button that lobotomizes the fly on the robot
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/companion/companion/tools/pi/remote_button.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
