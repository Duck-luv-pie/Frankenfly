# The remote at boot. On the REMOTE Pi (the card from tools/remote_card.sh installs this by itself; by hand:)
#   sudo apt install python3-gpiozero python3-lgpio && sudo cp remote-button.service /etc/systemd/system/ && sudo systemctl enable --now remote-button
# journalctl -u remote-button -f  shows every press and what the robot reports.
[Unit]
Description=Companion remote: START / STOP / LOBOTOMY buttons and lights for the fly on the robot
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/companion/remote_button.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
