# The fly on the robot at boot. Install on the Pi:
#   sudo cp ~/companion/tools/pi/companion-hunt.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now companion-hunt      # journalctl -u companion-hunt -f  to watch it
# Camera source: CAM_URL=... in /home/companion/companion-hunt.env (default the ESP32-CAM by name).
[Unit]
Description=Companion: the fly brain hunting through the camera, driving the RoboMaster S1
After=network-online.target
Wants=network-online.target

[Service]
User=companion
WorkingDirectory=/home/companion/companion/brain
EnvironmentFile=-/home/companion/companion-hunt.env
ExecStart=/bin/bash /home/companion/companion/tools/pi/companion-hunt.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
